---
import type { LanguageCode, ui } from '@/i18n/ui';
import { EmptyState } from '@/components/empty-state';
import { ArrowUpRight } from 'lucide-react';
import type { TranslatedProject } from '../type';

export type Props = {
  projects: Array<TranslatedProject>;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { projects, t } = Astro.props;
const projectsPageTranslations = t.projectsPage;

const getProjectRole = (project: TranslatedProject) => {
  if (project.collaborators && project.collaborators.length > 0) {
    const userCollab = project.collaborators.find(
      (c) => c.githubUsername === 'ahmdsaif87'
    );
    if (userCollab && userCollab.roles.length > 0) {
      return userCollab.roles[0];
    }
  }
  return 'Creator';
};
---

<div class="max-w-2xl mx-auto px-6 py-10 md:py-16">
  <div class="mb-8">
    <h1
      class="text-3xl md:text-4xl font-semibold tracking-tight font-serif text-foreground pb-2"
    >
      {projectsPageTranslations?.title ?? 'Projects'}
    </h1>
    <p class="text-sm text-muted-foreground leading-relaxed">
      A comprehensive list of products, mobile applications, and software tools
      I have built and contributed to.
    </p>
  </div>

  {
    projects && projects.length > 0 ? (
      <div class="divide-y divide-border border-y border-border">
        {projects.map((project: TranslatedProject) => (
          <div class="group relative flex items-baseline justify-between gap-4 py-4 px-2 hover:bg-muted/40 rounded-md transition-colors">
            <div class="min-w-0 flex-1">
              <h2 class="font-serif text-[1.05rem] font-medium text-foreground inline-flex items-center gap-1">
                <a href={`/projects/${project.slug}`} class="hover:underline">
                  {project.title}
                </a>
                <ArrowUpRight className="size-3.5 text-muted-foreground transition group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </h2>
              <p class="text-sm text-muted-foreground mt-0.5 leading-relaxed">
                {project.description}
              </p>
              {project.tags && project.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-2.5">
                  {project.tags.slice(0, 4).map((tag) => (
                    <span class="text-[11px] px-2 py-0.5 rounded border border-border/80 bg-card/40 text-muted-foreground">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <span class="shrink-0 text-xs md:text-sm text-muted-foreground font-medium pt-0.5">
              {getProjectRole(project)}
            </span>
            <a
              href={`/projects/${project.slug}`}
              class="absolute inset-0"
              aria-label={`View ${project.title}`}
            >
              <span class="sr-only">View project {project.title}</span>
            </a>
          </div>
        ))}
      </div>
    ) : (
      <EmptyState
        title={projectsPageTranslations?.noProjects}
        description={projectsPageTranslations?.noProjectsDescription}
      />
    )
  }
</div>

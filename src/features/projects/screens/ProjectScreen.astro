---
import { type LanguageCode, type ui } from '@/i18n/ui';
import { Image } from 'astro:assets';
import { Code, ArrowLeft, ArrowUpRight } from 'lucide-react';
import ProjectGallery from '../components/ProjectGallery';
import type { TranslatedProject } from '../type';

export type Props = {
  project: TranslatedProject;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { project, t } = Astro.props;
---

<div class="max-w-2xl mx-auto px-6 py-10 md:py-16">
  <article>
    {/* Back link */}
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8 group"
    >
      <ArrowLeft
        className="size-4 transition-transform duration-200 group-hover:-translate-x-1"
      />
      {t.projectDetailPage?.backToProjects ?? 'Back to projects'}
    </a>

    <header class="mb-8">
      <h1
        class="text-3xl md:text-4xl font-semibold tracking-tight font-serif text-foreground mb-3"
      >
        {project.title}
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed mb-4">
        {project.description}
      </p>

      <div
        class="flex flex-wrap items-center gap-2 pt-1 text-xs text-muted-foreground"
      >
        {
          project.categoryText && (
            <span class="px-2.5 py-1 rounded-md border border-border bg-card/60 font-medium">
              {project.categoryText}
            </span>
          )
        }
        {
          project.dateText && (
            <span class="px-2.5 py-1 rounded-md border border-border bg-card/60">
              {project.dateText}
            </span>
          )
        }
      </div>
    </header>

    {
      project.collaborators && project.collaborators.length > 0 && (
        <div class="mb-8 pb-6 border-b border-border">
          <p class="text-xs uppercase tracking-wider text-muted-foreground font-semibold mb-3">
            Collaborators
          </p>
          <div class="flex flex-wrap gap-2.5">
            {project.collaborators.map((collab) => (
              <a
                href={`https://github.com/${collab.githubUsername}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-border bg-card/40 hover:border-foreground/40 transition-colors text-xs"
              >
                <img
                  src={`https://github.com/${collab.githubUsername}.png`}
                  alt={collab.name}
                  width="20"
                  height="20"
                  class="size-5 rounded-full"
                />
                <span class="font-medium text-foreground">{collab.name}</span>
                <span class="text-muted-foreground">
                  ({collab.roles.join(', ')})
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      project.imageUrl && (
        <div class="relative overflow-hidden mb-10 rounded-xl border border-border shadow-sm">
          <a
            href={project.imageUrl.src}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full h-full"
          >
            <Image
              src={project.imageUrl}
              alt={project.imageAltText}
              class="w-full h-auto object-cover"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 800px"
            />
          </a>
        </div>
      )
    }

    {
      (project.detailedDescription ||
        (project.keyFeatures && project.keyFeatures.length > 0)) && (
        <section class="mb-10 space-y-4">
          <h2 class="font-serif text-xl font-semibold tracking-tight text-foreground">
            {t.projectDetailPage?.aboutTitle ?? 'Overview'}
          </h2>
          {project.detailedDescription && (
            <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
              {project.detailedDescription}
            </p>
          )}
          {project.keyFeatures && project.keyFeatures.length > 0 && (
            <div class="pt-2">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
                {t.projectDetailPage?.keyFeaturesTitle ?? 'Key Features'}
              </p>
              <ul class="space-y-2 text-sm">
                {project.keyFeatures.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-primary flex-shrink-0" />
                    <div>
                      <strong class="font-medium text-foreground">
                        {feature.title}:
                      </strong>
                      <span class="text-muted-foreground ml-1">
                        {feature.description}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    {
      project.technologiesUsed && project.technologiesUsed.length > 0 && (
        <section class="mb-10 pb-8 border-b border-border">
          <h2 class="font-serif text-xl font-semibold tracking-tight text-foreground mb-4">
            {t.projectDetailPage?.technologiesUsedTitle ?? 'Technologies Used'}
          </h2>
          <div class="grid gap-2.5 sm:grid-cols-2">
            {project.technologiesUsed.map((tech) => (
              <div class="p-3 rounded-lg border border-border bg-card/40">
                <p class="font-medium text-foreground text-sm">{tech.name}</p>
                {tech.description && (
                  <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                    {tech.description}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      project.outcome && (
        <section class="mb-10 pb-8 border-b border-border">
          <h2 class="font-serif text-xl font-semibold tracking-tight text-foreground mb-2">
            {t.projectDetailPage?.outcomeTitle ?? 'Outcome'}
          </h2>
          <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
            {project.outcome}
          </p>
        </section>
      )
    }

    {
      project.galleryImagesTranslated &&
        project.galleryImagesTranslated.length > 0 && (
          <section class="mb-10">
            <h2 class="font-serif text-xl font-semibold tracking-tight text-foreground mb-4">
              {t.projectDetailPage?.galleryTitle ?? 'Gallery'}
            </h2>
            <ProjectGallery
              client:visible
              images={project.galleryImagesTranslated.map((image) => ({
                src: image.src.src,
                alt: image.alt,
                caption: image.caption,
                id: image.id,
              }))}
            />
          </section>
        )
    }

    {/* Project Action Links */}
    <div class="flex flex-wrap gap-3 pt-4">
      {
        project.projectUrl && (
          <a
            href={project.projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn-primary"
          >
            Visit Live Demo
            <ArrowUpRight className="size-4" />
          </a>
        )
      }
      {
        project.codeUrl && (
          <a
            href={project.codeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn-outline"
          >
            <Code className="size-4" />
            {t.projectDetailPage?.viewCodeButton ?? 'Source Code'}
          </a>
        )
      }
    </div>
  </article>
</div>

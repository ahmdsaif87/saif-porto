---
import type { LanguageCode } from '@/i18n/ui';
import {
  ArrowUpRight,
  Mail,
  MessageSquare,
  Briefcase,
  GraduationCap,
} from 'lucide-react';
import heroImage from '@/assets/user-hero.webp';
import { Image } from 'astro:assets';
import type { TranslatedProject, TranslatedSkill } from '../type';
import { ContactForm } from '@/features/contact/components/ContactForm.tsx';
import type { ContactFormTranslations } from '@/features/contact/type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroGreeting: string;
  heroSubtitlePart1: string;
  heroSubtitlePart2: string;
  heroIntroduction: string;
  heroViewWorkButton: string;
  heroContactButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string;
  aboutMeTitle: string;
  aboutMeDescription: string;
  experienceTitle: string;
  experiences: Array<{
    title: string;
    company: string;
    date: string;
    description: string;
  }>;
  educationTitle: string;
  educations: Array<{
    degree: string;
    school: string;
    date: string;
    description: string;
  }>;
  contactFormTitle: string;
  contactFormTranslations: ContactFormTranslations;
};

const {
  lang,
  projects,
  experiences,
  educations,
  contactFormTitle,
  contactFormTranslations,
} = Astro.props;

// Curated primary tech stack (focused & resized)
const coreStack = [
  { name: 'Flutter & Dart', role: 'Mobile' },
  { name: 'React & Next.js', role: 'Frontend' },
  { name: 'Laravel & PHP', role: 'Backend' },
  { name: 'Python & FastAPI', role: 'Backend / AI' },
  { name: 'TypeScript', role: 'Web' },
  { name: 'PostgreSQL / MySQL', role: 'Database' },
  { name: 'TailwindCSS', role: 'Styling' },
];

// Determine role badge for each project
const getProjectRole = (project: TranslatedProject) => {
  if (project.collaborators && project.collaborators.length > 0) {
    const userCollab = project.collaborators.find(
      (c) => c.githubUsername === 'ahmdsaif87'
    );
    if (userCollab && userCollab.roles.length > 0) {
      return userCollab.roles[0];
    }
  }
  return 'Creator';
};
---

<div class="max-w-2xl mx-auto px-6 py-8 md:py-16">
  {/* ═══════════════════════════════════════════════════════ */}
  {/* ===== HERO SECTION ===== */}
  {/* ═══════════════════════════════════════════════════════ */}
  <header id="hero" class="pt-4 pb-12 scroll-mt-20">
    {/* Status badge: ATM twist */}
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-muted/60 border border-border/70 text-xs text-muted-foreground mb-6"
    >
      <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Available for freelance & collaboration</span>
    </div>

    <h1
      class="text-3xl md:text-4xl font-semibold tracking-tight font-serif text-foreground mb-6"
    >
      Ahmad Saif
    </h1>

    <div
      class="max-w-[65ch] space-y-4 text-sm md:text-base leading-relaxed text-muted-foreground"
    >
      <p>
        Software Developer based in Tegal, Indonesia. Gaining hands-on
        experience in building Flutter, React, Next.js, and Laravel applications
        with modern workflows. I focus on understanding application flow,
        solving practical problems, refining UI/UX, and taking projects from
        concept to completion.
      </p>
    </div>

    <div class="inline-flex items-center gap-3 pt-6">
      <a
        href="https://drive.google.com/file/d/1CMHRLsv7uKB4XYWMGiYwJgby1ejnxQ3f/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="pill-btn-primary"
      >
        Peek my résumé
        <ArrowUpRight className="size-4" />
      </a>
      <a href="#contact" class="pill-btn-outline"> Get in touch </a>
    </div>
  </header>

  {/* ═══════════════════════════════════════════════════════ */}
  {/* ===== CURATED TOOLBOX ===== */}
  {/* ═══════════════════════════════════════════════════════ */}
  <section class="pt-10 md:pt-12">
    <div class="mb-4">
      <h2
        class="font-serif text-xl md:text-2xl font-semibold tracking-tight text-foreground pb-1"
      >
        Core Stack
      </h2>
      <p class="text-sm text-muted-foreground">
        Primary technologies I specialize in and build with daily.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2">
      {
        coreStack.map((tech) => (
          <div class="p-2.5 rounded-lg border border-border/70 bg-card/40 hover:bg-muted/40 transition-colors flex flex-col justify-between">
            <span class="text-xs font-medium text-foreground">{tech.name}</span>
            <span class="text-[11px] text-muted-foreground mt-0.5">
              {tech.role}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════ */}
  {/* ===== PROJECTS SECTION ===== */}
  {/* ═══════════════════════════════════════════════════════ */}
  <section id="projects" class="pt-14 md:pt-16 scroll-mt-16">
    <div class="mb-5">
      <h2
        class="font-serif text-xl md:text-2xl font-semibold tracking-tight text-foreground pb-1"
      >
        Projects
      </h2>
      <p class="text-sm text-muted-foreground">
        A mix of hobby projects, mobile apps, and products I help build.
      </p>
    </div>

    <div class="divide-y divide-border border-y border-border">
      {
        projects.slice(0, 5).map((project) => (
          <div class="group relative flex items-baseline justify-between gap-4 py-3.5 px-2 hover:bg-muted/40 rounded-md transition-colors">
            <div class="min-w-0 flex-1">
              <h3 class="font-serif text-[1.025rem] font-medium text-foreground inline-flex items-center gap-1">
                <a href={`/projects/${project.slug}`} class="hover:underline">
                  {project.title}
                </a>
                <ArrowUpRight className="size-3.5 text-muted-foreground transition group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </h3>
              <p class="text-sm text-muted-foreground mt-0.5 line-clamp-2">
                {project.description}
              </p>
            </div>
            <div class="shrink-0 text-right">
              <span class="text-xs md:text-sm text-muted-foreground font-medium block">
                {getProjectRole(project)}
              </span>
              {project.category && (
                <span class="text-[11px] text-muted-foreground/70 hidden sm:inline-block">
                  {project.category}
                </span>
              )}
            </div>
            <a
              href={`/projects/${project.slug}`}
              class="absolute inset-0"
              aria-label={`View ${project.title}`}
            >
              <span class="sr-only">View project {project.title}</span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="pt-4">
      <a
        href="/projects"
        class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        View all projects <ArrowUpRight className="size-3.5" />
      </a>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════ */}
  {/* ===== JOURNEY: EXPERIENCE & EDUCATION (2 DISTINCT SECTIONS) ===== */}
  {/* ═══════════════════════════════════════════════════════ */}
  <section id="journey" class="pt-14 md:pt-16 space-y-12 scroll-mt-16">
    {/* Section 1: Experience */}
    <div>
      <div class="mb-4 flex items-center gap-2">
        <Briefcase className="size-4 text-primary" />
        <h2
          class="font-serif text-xl md:text-2xl font-semibold tracking-tight text-foreground"
        >
          Work Experience
        </h2>
      </div>
      <p class="text-sm text-muted-foreground mb-4">
        Professional roles, freelancing, and engineering engagements.
      </p>

      <div class="divide-y divide-border border-y border-border">
        {
          experiences.map((exp) => (
            <div class="py-4 px-2 hover:bg-muted/20 rounded-md transition-colors">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-[1.025rem] font-medium text-foreground">
                  {exp.title}
                </h3>
                <span class="text-xs font-mono text-muted-foreground shrink-0">
                  {exp.date}
                </span>
              </div>
              <p class="text-xs font-medium text-primary mt-0.5">
                {exp.company}
              </p>
              <p class="text-sm text-muted-foreground mt-1.5 leading-relaxed">
                {exp.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Section 2: Education */}
    <div>
      <div class="mb-4 flex items-center gap-2">
        <GraduationCap className="size-4 text-primary" />
        <h2
          class="font-serif text-xl md:text-2xl font-semibold tracking-tight text-foreground"
        >
          Education
        </h2>
      </div>
      <p class="text-sm text-muted-foreground mb-4">
        Formal academic education and technical foundation.
      </p>

      <div class="divide-y divide-border border-y border-border">
        {
          educations.map((edu) => (
            <div class="py-4 px-2 hover:bg-muted/20 rounded-md transition-colors">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-[1.025rem] font-medium text-foreground">
                  {edu.degree}
                </h3>
                <span class="text-xs font-mono text-muted-foreground shrink-0">
                  {edu.date}
                </span>
              </div>
              <p class="text-xs font-medium text-primary mt-0.5">
                {edu.school}
              </p>
              <p class="text-sm text-muted-foreground mt-1.5 leading-relaxed">
                {edu.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════ */}
  {/* ===== FEATURE CARD: GOT SOMETHING INTERESTING? ===== */}
  {/* ═══════════════════════════════════════════════════════ */}
  <section id="contact" class="pt-16 md:pt-20 scroll-mt-16">
    <div class="feature-banner-card overflow-hidden">
      {/* Top Banner Graphic */}
      <div
        class="h-52 md:h-60 w-full relative overflow-hidden bg-muted/50 border-b border-border"
      >
        <Image
          src={heroImage}
          alt="Ahmad Saif"
          widths={[400, 800]}
          sizes="100vw"
          class="w-full h-full object-cover grayscale opacity-80 hover:grayscale-0 transition-all duration-700"
          style="object-position: center 38%;"
        />
        <div
          class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-background/90 via-background/30 to-transparent pointer-events-none"
        >
        </div>
      </div>

      {/* Card Content */}
      <div class="p-6 md:p-8">
        <h2
          class="font-serif text-xl md:text-2xl font-semibold text-foreground tracking-tight mb-2"
        >
          Let's build something together.
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-xl mb-6">
          Looking for a Flutter mobile developer, a React/Next.js frontend, or a
          full-stack partner for your product? I'm open for freelance work,
          contract roles, and technical collaboration.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="mailto:ahmadsaifpy@gmail.com" class="pill-btn-primary">
            <Mail className="size-4" />
            Send an email
          </a>
          <a
            href="https://www.linkedin.com/in/ahmadsaif-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn-outline"
          >
            LinkedIn
            <ArrowUpRight className="size-3.5" />
          </a>
          <a
            href="https://github.com/ahmdsaif87"
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn-outline"
          >
            GitHub
            <ArrowUpRight className="size-3.5" />
          </a>
        </div>

        {/* Embedded clean contact form toggle */}
        <details class="mt-8 pt-6 border-t border-border group/details">
          <summary
            class="text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground cursor-pointer select-none font-medium flex items-center gap-1.5"
          >
            <MessageSquare className="size-3.5" />
            <span>Or send a direct message from here</span>
          </summary>
          <div class="pt-5">
            <ContactForm
              client:load
              {lang}
              formTranslations={contactFormTranslations}
            />
          </div>
        </details>
      </div>
    </div>
  </section>
</div>

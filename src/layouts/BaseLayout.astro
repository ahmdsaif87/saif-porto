---
import '../styles/global.css';
import {
  defaultLanguage,
  useTranslations,
  type LanguageCode,
} from '../i18n/ui';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { Home, Briefcase, MessageSquare, FileText } from 'lucide-react';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

import { Toaster } from 'sonner';

export type Props = {
  pageTitle: string;
  pageDescription?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[] | string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  publishDate?: string;
  modifiedDate?: string;
  isLandingPage?: boolean;
};

export type NavItem = {
  href: string;
  label: string;
  icon: any;
};

const {
  pageTitle,
  pageDescription,
  canonical,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  noindex = false,
  keywords,
  jsonLd,
  publishDate,
  modifiedDate,
  isLandingPage = false,
} = Astro.props;

const lang =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const currentPathname = Astro.url.pathname;

const tSite = useTranslations(lang, 'site');
const tNav = useTranslations(lang, 'nav');

// Landing page uses anchor links; other pages use regular routes
const navItems: Array<NavItem> = isLandingPage
  ? [
      { href: '#hero', label: tNav('home'), icon: Home },
      { href: '#projects', label: tNav('projects'), icon: Briefcase },
      { href: '#journey', label: 'Journey', icon: FileText },
      { href: '#contact', label: tNav('contact'), icon: MessageSquare },
    ]
  : [
      { href: '/', label: tNav('home'), icon: Home },
      { href: '/projects', label: tNav('projects'), icon: Briefcase },
      { href: '/contact', label: tNav('contact'), icon: MessageSquare },
    ];

const siteUrl = Astro.site ?? new URL('https://ahmadsaif.web.id');
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = new URL(ogImage, siteUrl).href;
const title = pageTitle || tSite('title');
const description = pageDescription || tSite('description');

const defaultKeywords = [
  'Ahmad Saifi Khayatu Ulumuddin',
  'Ahmad Saif',
  'Ahmad Saifi',
  'Full-Stack Developer',
  'Flutter Developer',
  'React Developer',
  'Laravel Developer',
  'Tegal',
  'Indonesia',
  'Mobile Developer',
  'Web Developer',
  'Software Engineer',
  'Portfolio',
];
const formattedKeywords = Array.isArray(keywords)
  ? keywords.join(', ')
  : keywords || defaultKeywords.join(', ');

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

// Base JSON-LD schemas
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://ahmadsaif.web.id/#person',
    name: 'Ahmad Saif',
    alternateName: [
      'Ahmad Saifi Khayatu Ulumuddin',
      'Ahmad Saifi',
      'ahmdsaif87',
    ],
    jobTitle: 'Full-Stack Developer',
    description:
      'Full-Stack Developer based in Tegal, Indonesia specializing in Flutter, React, Next.js, and Laravel.',
    url: 'https://ahmadsaif.web.id/',
    image: new URL('/og-image.jpg', siteUrl).href,
    email: 'ahmadsaifpy@gmail.com',
    sameAs: [
      'https://github.com/ahmdsaif87',
      'https://www.linkedin.com/in/ahmadsaif-dev',
      'https://www.instagram.com/ahmdsaif87',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Tegal',
      addressRegion: 'Central Java',
      addressCountry: 'ID',
    },
    knowsAbout: [
      'Flutter',
      'Dart',
      'React',
      'Next.js',
      'Laravel',
      'Python',
      'Flask',
      'TypeScript',
      'TailwindCSS',
      'REST APIs',
      'Full-Stack Development',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://ahmadsaif.web.id/#website',
    url: 'https://ahmadsaif.web.id/',
    name: 'Ahmad Saif - Full-Stack Developer Portfolio',
    description:
      'Official portfolio of Ahmad Saif, Full-Stack Developer based in Tegal, Indonesia.',
    inLanguage: 'en',
    publisher: {
      '@id': 'https://ahmadsaif.web.id/#person',
    },
  },
];

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...baseSchemas, ...pageSchemas];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={formattedKeywords} />
    <meta name="author" content="Ahmad Saif" />
    <meta name="theme-color" content="#09090b" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Verification -->
    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }

    <!-- Favicons & App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      const getInitialTheme = () => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        if (
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches
        ) {
          return 'dark';
        }
        return 'light';
      };
      const theme = getInitialTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('theme', theme);
      }
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Ahmad Saif" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {
      ogType === 'article' && (
        <meta property="article:author" content="Ahmad Saif" />
      )
    }
    {
      publishDate && (
        <meta property="article:published_time" content={publishDate} />
      )
    }
    {
      modifiedDate && (
        <meta property="article:modified_time" content={modifiedDate} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:creator" content="@ahmdsaif87" />

    <!-- Structured Data (JSON-LD) -->
    {
      allSchemas.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    <ClientRouter />
  </head>
  <body
    class="min-h-screen bg-background font-sans antialiased flex flex-col relative overflow-x-hidden"
  >
    {/* Noise grain overlay */}
    <div class="noise-overlay" aria-hidden="true"></div>

    <Header navItems={navItems as NavItem[]} isLandingPage={isLandingPage} />

    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <Footer />

    <Toaster position="bottom-right" richColors client:visible />

    {/* Scroll-triggered reveal observer */}
    <script is:inline>
      (function () {
        const initScrollReveal = () => {
          const els = document.querySelectorAll('.scroll-reveal');
          if (!els.length) return;

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
          );

          els.forEach((el) => observer.observe(el));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveal);
        } else {
          initScrollReveal();
        }
        document.addEventListener('astro:page-load', initScrollReveal);
      })();
    </script>
    <Analytics />
  </body>
</html>

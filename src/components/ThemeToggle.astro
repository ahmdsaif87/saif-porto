---
import { Moon, Sun } from 'lucide-react';

// Generate unique ID for each component instance
const uniqueId = `themeToggle-${crypto.randomUUID().slice(0, 8)}`;
---

<button
  id={uniqueId}
  class="relative overflow-hidden p-1.5 w-8 h-8 rounded-md flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors focus:outline-none"
  aria-label="Toggle theme"
>
  <Sun
    id="theme-sun-icon"
    className="h-[1rem] w-[1rem] rotate-0 scale-100 transition-transform duration-300 dark:-rotate-90 dark:scale-0"
  />
  <Moon
    id="theme-moon-icon"
    className="absolute h-[1rem] w-[1rem] rotate-90 scale-0 transition-transform duration-300 dark:rotate-0 dark:scale-100"
  />
</button>

<script define:vars={{ buttonId: uniqueId }}>
  // Disable all CSS transitions instantly so cards, borders, buttons, and text switch synchronously with 0ms delay
  const disableTransitions = () => {
    const css = document.createElement('style');
    css.id = 'theme-transition-blocker';
    css.appendChild(
      document.createTextNode(
        `*:not(#theme-sun-icon):not(#theme-moon-icon),
         *:not(#theme-sun-icon):not(#theme-moon-icon)::before,
         *:not(#theme-sun-icon):not(#theme-moon-icon)::after {
          -webkit-transition: none !important;
          -moz-transition: none !important;
          -o-transition: none !important;
          -ms-transition: none !important;
          transition: none !important;
        }`
      )
    );
    document.head.appendChild(css);

    return () => {
      // Force restyle / reflow
      void document.documentElement.offsetHeight;

      // Re-enable transitions after the repaint tick
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          const el = document.getElementById('theme-transition-blocker');
          if (el) el.remove();
        });
      });
    };
  };

  const applyThemeFromLocalStorage = () => {
    const theme =
      (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) ||
      'light';
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  };

  const handleToggleClick = () => {
    const enableTransitions = disableTransitions();

    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    enableTransitions();
  };

  const setupThemeToggleButton = () => {
    const toggleButton = document.getElementById(buttonId);
    if (toggleButton) {
      toggleButton.removeEventListener('click', handleToggleClick);
      toggleButton.addEventListener('click', handleToggleClick);
    }
  };

  document.addEventListener('astro:after-swap', applyThemeFromLocalStorage);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThemeToggleButton);
  } else {
    setupThemeToggleButton();
  }
  document.addEventListener('astro:page-load', setupThemeToggleButton);
</script>

---
import { defaultLanguage, useTranslations, type LanguageCode } from '@/i18n/ui';

const lang =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const tFooter = useTranslations(lang, 'footer');
const tSite = useTranslations(lang, 'site');
---

<footer class="relative mt-auto py-8 z-10 border-t border-border">
  <div
    class="container mx-auto px-6 max-w-screen-xl flex flex-col md:flex-row justify-between items-center gap-4"
  >
    <p
      class="text-xs text-muted-foreground uppercase tracking-widest text-center md:text-left"
      style="font-family: var(--font-heading);"
    >
      &copy; {new Date().getFullYear()}
      <span class="font-medium text-foreground"> {tSite('title')}</span>. {
        tFooter('rights')
      }
    </p>

    <nav
      aria-label="Footer Navigation"
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
    >
      <a
        href="/"
        class="text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-200"
        style="font-family: var(--font-heading);"
      >
        Home
      </a>
      <a
        href="/projects"
        class="text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-200"
        style="font-family: var(--font-heading);"
      >
        Projects
      </a>
      <a
        href="/contact"
        class="text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-200"
        style="font-family: var(--font-heading);"
      >
        Contact
      </a>
      <a
        href="/sitemap-index.xml"
        target="_blank"
        class="text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-200"
        style="font-family: var(--font-heading);"
      >
        Sitemap
      </a>
    </nav>
  </div>
</footer>

---
import type { NavItem } from '@/layouts/BaseLayout.astro';
import {
  ArrowUpRight,
  Check,
  FileText,
  FolderKanban,
  Github,
  Home,
  Linkedin,
  Mail,
  Milestone,
} from 'lucide-react';

interface Props {
  navItems: Array<NavItem>;
  isLandingPage?: boolean;
}
const { navItems } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const getNavIcon = (label: string) => {
  const l = label.toLowerCase();
  if (l.includes('home')) return Home;
  if (l.includes('project')) return FolderKanban;
  if (l.includes('journey')) return Milestone;
  if (l.includes('contact')) return Mail;
  return Home;
};
---

<div class="relative sm:hidden">
  {/* Slick 2-line Morphing Hamburger Button */}
  <button
    id="mobile-menu-btn"
    class="relative z-50 p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors focus:outline-none"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
  >
    <div
      class="w-4 h-4 flex flex-col justify-center items-center gap-1 pointer-events-none"
    >
      <span
        id="burger-line-1"
        class="w-3.5 h-[1.5px] bg-current rounded-full transition-all duration-200 origin-center"
      ></span>
      <span
        id="burger-line-2"
        class="w-3.5 h-[1.5px] bg-current rounded-full transition-all duration-200 origin-center"
      ></span>
    </div>
  </button>

  {/* Invisible click-outside dismiss backdrop */}
  <div
    id="mobile-backdrop"
    class="fixed inset-0 z-40 bg-black/10 transition-opacity duration-200 opacity-0 pointer-events-none"
  >
  </div>

  {/* Compact Floating Popover Menu (Matching screenshot width & style) */}
  <div
    id="mobile-panel"
    class="absolute right-0 top-full mt-2 z-50 w-52 rounded-2xl border border-border/80 bg-card/95 backdrop-blur-xl shadow-2xl p-1.5 transition-all duration-200 origin-top-right transform scale-95 opacity-0 pointer-events-none"
  >
    {/* Navigation Section */}
    <div
      class="px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground/70"
    >
      Navigation
    </div>

    <nav class="flex flex-col space-y-0.5">
      {
        navItems.map((item) => {
          const isAnchor = item.href.startsWith('#');
          const href = item.href;
          const isHomeItem =
            href === '#hero' || href === '/' || href === '/#hero';

          let isActive = false;
          if (isHome) {
            isActive = isHomeItem;
          } else {
            if (href === '/projects' && currentPath.startsWith('/projects')) {
              isActive = true;
            } else if (
              href === '/contact' &&
              currentPath.startsWith('/contact')
            ) {
              isActive = true;
            } else if (!isAnchor && currentPath === href) {
              isActive = true;
            }
          }
          const Icon = getNavIcon(item.label);
          const sectionKey = href.includes('#') ? href.split('#')[1] : '';

          return (
            <a
              href={href}
              data-nav-href={href}
              data-section={sectionKey}
              class:list={[
                'mobile-nav-link flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors',
                isActive
                  ? 'bg-muted/80 text-foreground'
                  : 'text-muted-foreground hover:text-foreground hover:bg-muted/50',
              ]}
            >
              <div class="flex items-center gap-2">
                <Icon className="size-3.5 text-muted-foreground" />
                <span>{item.label}</span>
              </div>
              <span
                class:list={[
                  'nav-check-indicator shrink-0',
                  !isActive && 'hidden',
                ]}
              >
                <Check className="size-3.5 text-accent" />
              </span>
            </a>
          );
        })
      }
    </nav>

    {/* Divider */}
    <div class="my-1.5 border-t border-border/60"></div>

    {/* Quick Links Section */}
    <div
      class="px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground/70"
    >
      Links
    </div>

    <div class="flex flex-col space-y-0.5">
      <a
        href="https://drive.google.com/file/d/1CMHRLsv7uKB4XYWMGiYwJgby1ejnxQ3f/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <div class="flex items-center gap-2">
          <FileText className="size-3.5 text-muted-foreground" />
          <span>Résumé</span>
        </div>
        <ArrowUpRight className="size-3 text-muted-foreground" />
      </a>

      <a
        href="https://github.com/ahmdsaif87"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <div class="flex items-center gap-2">
          <Github className="size-3.5 text-muted-foreground" />
          <span>GitHub</span>
        </div>
        <ArrowUpRight className="size-3 text-muted-foreground" />
      </a>

      <a
        href="https://www.linkedin.com/in/ahmadsaif-dev"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <div class="flex items-center gap-2">
          <Linkedin className="size-3.5 text-muted-foreground" />
          <span>LinkedIn</span>
        </div>
        <ArrowUpRight className="size-3 text-muted-foreground" />
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const setupMenu = () => {
      const btn = document.getElementById('mobile-menu-btn');
      const panel = document.getElementById('mobile-panel');
      const backdrop = document.getElementById('mobile-backdrop');
      const line1 = document.getElementById('burger-line-1');
      const line2 = document.getElementById('burger-line-2');
      const links = document.querySelectorAll('.mobile-nav-link');

      if (!btn || !panel || !backdrop || !line1 || !line2) return;

      let isOpen = false;

      const setOpen = (open) => {
        isOpen = open;
        btn.setAttribute('aria-expanded', String(isOpen));

        if (isOpen) {
          // Morph burger lines into X
          line1.style.transform = 'translateY(2.5px) rotate(45deg)';
          line2.style.transform = 'translateY(-2.5px) rotate(-45deg)';

          // Open panel
          panel.classList.remove(
            'scale-95',
            'opacity-0',
            'pointer-events-none'
          );
          panel.classList.add(
            'scale-100',
            'opacity-100',
            'pointer-events-auto'
          );

          // Open backdrop
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          // Revert burger lines
          line1.style.transform = '';
          line2.style.transform = '';

          // Close panel
          panel.classList.remove(
            'scale-100',
            'opacity-100',
            'pointer-events-auto'
          );
          panel.classList.add('scale-95', 'opacity-0', 'pointer-events-none');

          // Close backdrop
          backdrop.classList.remove('opacity-100', 'pointer-events-auto');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
        }
      };

      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        setOpen(!isOpen);
      };

      backdrop.onclick = () => setOpen(false);

      links.forEach((link) => {
        link.onclick = () => setOpen(false);
      });

      // Escape key closes popup
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) setOpen(false);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMenu);
    } else {
      setupMenu();
    }
    document.addEventListener('astro:page-load', setupMenu);
  })();
</script>
